# ==========================
# TradeDesk Pro env template
# ==========================
# Copy to .env.local and fill values.
# Never commit your real .env.local.

# --- Firebase ---
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Polygon ---
VITE_POLYGON_API_KEY=your_polygon_api_key
VITE_POLYGON_BASE_URL=https://api.polygon.io/v3

# --- Optional AI Discipline Coach Overlay ---
# Backend endpoint preferred (secure). If unset, app falls back to local-only discipline coaching.
VITE_DISCIPLINE_COACH_ENDPOINT=
VITE_DISCIPLINE_COACH_API_KEY=
VITE_DISCIPLINE_COACH_TIMEOUT_MS=12000

# --- Optional Ollama (Screenshot AI via Gemma 4) ---
# Configure your installed Ollama model names (no code hardcoded fallbacks).
VITE_OLLAMA_BASE_URL=http://localhost:11434/api/chat
VITE_OLLAMA_MODEL=your_ollama_model
# Optional chat-specific override (falls back to VITE_OLLAMA_MODEL)
VITE_OLLAMA_CHAT_MODEL=your_chat_model
# Optional review-specific override (falls back to VITE_OLLAMA_CHAT_MODEL or VITE_OLLAMA_MODEL)
VITE_OLLAMA_TRADE_REVIEW_MODEL=your_trade_review_model
# Optional morning-brief-specific override (falls back to VITE_OLLAMA_CHAT_MODEL or VITE_OLLAMA_MODEL)
VITE_OLLAMA_MORNING_BRIEF_MODEL=your_morning_brief_model
# Optional comma-separated model list for chat dropdown presets
VITE_OLLAMA_MODEL_PRESETS=
# Optional: usually blank for local Ollama; use only for secured/proxied Ollama endpoints.
VITE_OLLAMA_API_KEY=
VITE_OLLAMA_TIMEOUT_MS=90000
VITE_OLLAMA_CONCURRENCY=2

# --- Optional backend endpoints for AI features ---
# If set, these endpoints are used instead of direct Ollama calls for the specific feature.
VITE_TRADE_REVIEW_ENDPOINT=
VITE_TRADE_REVIEW_API_KEY=
VITE_TRADE_REVIEW_TIMEOUT_MS=20000
VITE_MORNING_BRIEF_ENDPOINT=
VITE_MORNING_BRIEF_API_KEY=
VITE_MORNING_BRIEF_TIMEOUT_MS=20000

# --- Base44 app params (optional) ---
# These are read by src/lib/config/app-params.js
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_APP_BASE_URL=

# --- Electron secure AI env (recommended for desktop builds) ---
# These are read by Electron main process and are NOT exposed to renderer bundles.
# Prefer these keys in production desktop deployments.
OLLAMA_BASE_URL=http://localhost:11434/api/chat
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_MS=90000
TRADE_REVIEW_ENDPOINT=
TRADE_REVIEW_API_KEY=
TRADE_REVIEW_TIMEOUT_MS=20000
MORNING_BRIEF_ENDPOINT=
MORNING_BRIEF_API_KEY=
MORNING_BRIEF_TIMEOUT_MS=20000
DISCIPLINE_COACH_ENDPOINT=
DISCIPLINE_COACH_API_KEY=
DISCIPLINE_COACH_TIMEOUT_MS=12000
